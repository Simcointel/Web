# Maintenance Mode (Kill Switch) — Gist Config
# Create a public GitHub Gist with a `maintenance.json` file:
#   { "maintenance_enabled": false, "maintenance_title": "Site Under Maintenance", "maintenance_message": "We're performing scheduled maintenance. Please check back soon.", "maintenance_retry_after": 300 }
# Then set the raw URL here (no trailing slash):
VITE_MAINTENANCE_CONFIG_URL=

# Backend API base (optional — defaults to /api for local dev with Vite proxy)
# Production: set to actual Vercel backend URL
VITE_API_BASE=/api
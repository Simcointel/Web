{
  "manifest_version": 3,
  "name": "SimcoIntel \u2014 SimCo Market Data",
  "version": "1.2.0",
  "description": "Real-time SimCompanies market data, profit margins, retail saturation, and macro indicators at a glance. Syncs company data to the SimcoIntel web dashboard.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://raw.githubusercontent.com/SimcoIntel/Data/*",
    "https://simcointel.github.io/*"
  ],
  "externally_connectable": {
    "matches": ["https://simcointel.github.io/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.simcompanies.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    },
    {
      "matches": [
        "https://simcointel.github.io/*"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "simcointel@simcointel.github.io",
      "strict_min_version": "109.0"
    }
  }
}

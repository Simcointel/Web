{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "npx http-server dist -p 8080 -c-1",
      "url": [
        "http://localhost:8080",
        "http://localhost:8080/macro",
        "http://localhost:8080/profit-margins",
        "http://localhost:8080/corporate-suite",
        "http://localhost:8080/profit-calculator",
        "http://localhost:8080/construction-calculator",
        "http://localhost:8080/retail-calculator",
        "http://localhost:8080/xp-calculator",
        "http://localhost:8080/about",
        "http://localhost:8080/alerts"
      ],
      "settings": {
        "staticDistDir": "./dist"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}